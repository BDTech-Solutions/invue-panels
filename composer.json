{
    "name": "invue/panels",
    "description": "Panel + Resource CRUD scaffolding for the Invue framework: artisan generators that produce real Controller/FormRequest/Vue pages wired to invue/tables and invue/forms, plus a swappable panel shell (sidebar/topbar) via invue/core's component registry.",
    "keywords": ["laravel", "inertia", "vue", "panels", "invue"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^1.0|^2.0|^3.0",
        "invue/core": "self.version",
        "invue/forms": "self.version",
        "invue/tables": "self.version"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Invue\\Panels\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Invue\\Panels\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Invue\\Panels\\PanelsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
