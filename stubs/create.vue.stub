<script setup>
import { useForm } from '@inertiajs/vue3'
import { %%FORM_IMPORTS%%, useInvueField } from 'invue/forms'
import { PanelLayout } from 'invue/panels'

const breadcrumbs = [
    { label: '%%NAVIGATION_LABEL%%', url: '%%INDEX_URL%%' },
    { label: 'Create' },
]

const form = useForm({
%%FORM_INITIAL%%
})

%%FORM_FIELD_BINDINGS%%

function submit() {
    form.post('%%STORE_URL%%')
}
</script>

<template>
    <PanelLayout :breadcrumbs="breadcrumbs">
        <h1 class="mb-6 text-xl font-semibold text-gray-900">New %%MODEL_LABEL%%</h1>

        <form class="max-w-lg space-y-4" novalidate @submit.prevent="submit">
%%FORM_FIELDS%%

            <button
                type="submit"
                class="rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-500"
                :disabled="form.processing"
            >
                Save
            </button>
        </form>
    </PanelLayout>
</template>
