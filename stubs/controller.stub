<?php

namespace {{ controllersNamespace }};

use App\Http\Controllers\Controller;
{{ modelUse }}
{{ requestUse }}
{{ notificationUse }}use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;
use Invue\Tables\TableQuery;

class {{ controllerClass }} extends Controller
{
    public function index(Request $request): Response
    {
        return Inertia::render('{{ pageBase }}/Index', [
            '{{ tableProp }}' => TableQuery::for({{ modelClass }}::query())
                ->searchable([{{ searchableColumns }}])
                ->sortable([{{ sortableColumns }}])
                ->defaultSort('{{ defaultSortColumn }}', 'desc')
                ->paginate($request),
        ]);
    }

    public function create(): Response
    {
        return Inertia::render('{{ pageBase }}/Create');
    }

    public function store({{ requestClass }} $request): RedirectResponse
    {
        {{ modelClass }}::create($request->validated());
{{ createdNotification }}
        return to_route('{{ indexRouteName }}');
    }
{{ showMethod }}
    public function edit({{ modelClass }} ${{ modelVariable }}): Response
    {
        return Inertia::render('{{ pageBase }}/Edit', [
            '{{ modelVariable }}' => ${{ modelVariable }},
        ]);
    }

    public function update({{ requestClass }} $request, {{ modelClass }} ${{ modelVariable }}): RedirectResponse
    {
        ${{ modelVariable }}->update($request->validated());
{{ updatedNotification }}
        return to_route('{{ indexRouteName }}');
    }

    public function destroy({{ modelClass }} ${{ modelVariable }}): RedirectResponse
    {
        ${{ modelVariable }}->delete();
{{ deletedNotification }}
        return to_route('{{ indexRouteName }}');
    }
}
